%% =====================================================================
%%  garyc.sty -- Estilo común para los documentos de los Talleres GARyC
%%  Análisis Económico y Computacional
%%
%%  Uso:  \usepackage{garyc}   (compilar con pdfLaTeX)
%% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{garyc}[2026/11/03 Estilo Talleres GARyC]

%% ---------------------------------------------------------------------
%% Idioma, codificación y tipografía
%% ---------------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[spanish,es-noquoting,es-nodecimaldot,es-tabla]{babel}
\RequirePackage[osf]{XCharter}                 % texto: Charter
\RequirePackage[charter,vvarbb]{newtxmath}     % matemáticas compatibles
\RequirePackage[scale=0.95,semibold]{sourcesanspro} % títulos: sans
\RequirePackage{microtype}
\RequirePackage{textcomp}
\RequirePackage{csquotes}

%% ---------------------------------------------------------------------
%% Página
%% ---------------------------------------------------------------------
\RequirePackage[letterpaper,top=2.6cm,bottom=2.6cm,left=2.7cm,right=2.7cm,
  headheight=14pt,headsep=0.9cm,footskip=1.2cm]{geometry}
\RequirePackage{setspace}
\setstretch{1.05}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em plus 0.15em minus 0.1em}
\RequirePackage{needspace}

%% ---------------------------------------------------------------------
%% Colores institucionales (misma paleta que la versión en Word)
%% ---------------------------------------------------------------------
\RequirePackage[table]{xcolor}
\definecolor{garycAzul}{HTML}{1B4F72}     % azul oscuro: títulos
\definecolor{garycAcento}{HTML}{2E86C1}   % azul medio: acentos
\definecolor{garycTexto}{HTML}{2C3E50}    % texto principal
\definecolor{garycGris}{HTML}{5D6D7E}     % texto secundario
\definecolor{garycClaro}{HTML}{D6EAF8}    % fondos claros
\definecolor{garycFondo}{HTML}{F4F8FB}    % fondo muy claro
\color{garycTexto}

%% ---------------------------------------------------------------------
%% Tablas, listas y cajas
%% ---------------------------------------------------------------------
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{ragged2e}
\RequirePackage{enumitem}
\RequirePackage[most]{tcolorbox}
\RequirePackage{calc}
\RequirePackage{caption}
\captionsetup{font={small,sf},labelfont={bf,color=garycAzul},skip=6pt}

\newcolumntype{L}{>{\RaggedRight\arraybackslash}X}
\newcolumntype{P}[1]{>{\RaggedRight\arraybackslash}p{#1}}

\setlist{itemsep=0.25em,topsep=0.3em,parsep=0pt}

%% ---------------------------------------------------------------------
%% Títulos de sección
%% ---------------------------------------------------------------------
\RequirePackage[explicit]{titlesec}
\setcounter{secnumdepth}{2}

% \section: talleres / bloques principales
\titleformat{\section}[block]
  {\sffamily\Large\bfseries\color{garycAzul}}
  {}{0pt}
  {#1}[\vspace{0.15em}{\color{garycAcento}\titlerule[1.2pt]}]
\titlespacing*{\section}{0pt}{1.6em}{0.9em}

% Variante con número visible (documento de recursos)
\newcommand{\seccionesnumeradas}{%
  \titleformat{\section}[block]
    {\sffamily\Large\bfseries\color{garycAzul}}
    {{\color{garycAcento}\thesection}}{0.7em}
    {##1}[\vspace{0.15em}{\color{garycAcento}\titlerule[1.2pt]}]}

% \subsection: módulos
\titleformat{\subsection}[block]
  {\sffamily\large\bfseries\color{garycAzul}}
  {}{0pt}{#1}
\titlespacing*{\subsection}{0pt}{1.3em}{0.4em}

% \subsubsection: encabezados menores (p. ej., Bibliografía)
\titleformat{\subsubsection}[block]
  {\sffamily\normalsize\bfseries\color{garycAcento}}
  {}{0pt}{#1}
\titlespacing*{\subsubsection}{0pt}{0.8em}{0.2em}

%% ---------------------------------------------------------------------
%% Encabezados y pies de página
%% ---------------------------------------------------------------------
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\newcommand{\garycDocumento}{}
\newcommand{\documento}[1]{\renewcommand{\garycDocumento}{#1}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\sffamily\footnotesize\color{garycGris}Talleres GARyC\,\textperiodcentered\,Análisis Económico y Computacional}
\fancyhead[R]{\sffamily\footnotesize\color{garycGris}\garycDocumento}
\fancyfoot[C]{\sffamily\footnotesize\color{garycGris}\thepage\ de \pageref*{LastPage}}
\renewcommand{\headrule}{{\color{garycClaro}\hrule height 0.6pt}\vspace{-0.6pt}}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrule}{}%
  \fancyfoot[C]{\sffamily\footnotesize\color{garycGris}\thepage\ de \pageref*{LastPage}}}

%% ---------------------------------------------------------------------
%% Hipervínculos y metadatos
%% ---------------------------------------------------------------------
\RequirePackage[hidelinks,pdfusetitle,bookmarksnumbered=false]{hyperref}
\RequirePackage{bookmark}

%% ---------------------------------------------------------------------
%% Bloque de título
%% ---------------------------------------------------------------------
%  \portada{<tipo de documento>}{<texto de presentación opcional>}
\newcommand{\portada}[1]{%
  \thispagestyle{plain}%
  \begingroup
  \vspace*{-1.2cm}%
  {\sffamily\small\bfseries\color{garycAcento}\MakeUppercase{Talleres GARyC}\par}%
  \vspace{0.35em}%
  {\sffamily\fontsize{24}{28}\selectfont\bfseries\color{garycAzul}Análisis Económico y Computacional\par}%
  \vspace{0.5em}%
  {\color{garycAcento}\rule{\linewidth}{1.6pt}}\par
  \vspace{0.15em}%
  {\sffamily\Large\color{garycGris}#1\par}%
  \endgroup
  \vspace{1.2em}%
}

%% ---------------------------------------------------------------------
%% Caja de presentación (resumen inicial)
%% ---------------------------------------------------------------------
\newtcolorbox{presentacion}{%
  enhanced, breakable,
  colback=garycFondo, colframe=garycFondo,
  borderline west={2.5pt}{0pt}{garycAcento},
  arc=0pt, outer arc=0pt,
  left=12pt, right=12pt, top=8pt, bottom=8pt,
  before skip=0.4em, after skip=1.2em,
  fontupper=\normalsize\setlength{\parskip}{0.55em}}

%% ---------------------------------------------------------------------
%% Elementos del syllabus
%% ---------------------------------------------------------------------
% Encabezado de taller:  \taller{1}{Título}{Descripción de horas y requisitos}
\newcommand{\taller}[3]{%
  \clearpage
  \phantomsection
  \section{Taller #1\ \textperiodcentered\ #2}%
  \vspace{-0.5em}%
  {\sffamily\small\itshape\color{garycGris}#3\par}%
  \vspace{0.4em}%
}

% Encabezado de módulo:  \modulo{1}{Título}{horas}
\newcommand{\modulo}[3]{%
  \Needspace{8\baselineskip}%
  \subsection[Módulo #1. #2]{%
    {\color{garycAcento}Módulo #1}\hspace{0.6em}#2%
    \hfill{\normalfont\sffamily\small\color{garycGris}#3}}%
}

% Lista de sesiones
\newenvironment{sesiones}{%
  \begin{description}[
    font=\sffamily\small\bfseries\color{garycAzul},
    leftmargin=6.2em, labelwidth=5.6em, labelsep=0.6em,
    style=sameline, align=left,
    itemsep=0.35em, topsep=0.4em]%
}{\end{description}}
\newcommand{\sesion}[1]{\item[Sesión #1]}

% Bibliografía de módulo
\newenvironment{bibliografia}{%
  \par\noindent\begin{minipage}{\linewidth}%
  \setlength{\parskip}{0pt}%
  {\sffamily\normalsize\bfseries\color{garycAcento}Bibliografía\par}\vspace{0.25em}%
  \begin{enumerate}[
    label={[\arabic*]}, font=\sffamily\footnotesize\color{garycAcento},
    leftmargin=2.2em, labelsep=0.5em, itemsep=0.15em, topsep=0.2em]%
  \small
}{\end{enumerate}\end{minipage}\par\vspace{0.4em}}

% Referencia:  \obra{Autores}{Año}{Título}{Datos de publicación}
\newcommand{\obra}[4]{\item #1 (#2). \textit{#3}. #4}
\newcommand{\recomendado}{\textcolor{garycGris}{\textit{(Recomendado por el equipo).}}}

%% ---------------------------------------------------------------------
%% Elementos del documento de recursos
%% ---------------------------------------------------------------------
\newenvironment{recursos}{%
  \begin{enumerate}[
    label={\arabic{section}.\arabic*}, font=\sffamily\small\bfseries\color{garycAcento},
    leftmargin=2.6em, labelsep=0.7em, itemsep=0.3em, topsep=0.2em]%
}{\end{enumerate}}
\newcommand{\recurso}[1]{\item {\sffamily\bfseries\color{garycAzul}#1.}\ }

\endinput
