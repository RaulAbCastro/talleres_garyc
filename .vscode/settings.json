{
  "workbench.colorTheme": "Rainier - Retro",
  "workbench.preferredDarkColorTheme": "Rainier - Retro",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "python-envs.workspaceSearchPaths": ["./.venv"],
  "python.terminal.activateEnvironment": false,
  "python-envs.terminal.autoActivationType": "off",
  "r.rterm.linux": "/usr/bin/R",
  "r.rpath.linux": "/usr/bin/R",
  "r.libPaths": ["${workspaceFolder}/.local/R/library"],
  "r.plot.backend": "httpgd",
  "r.sessionWatcher": true,
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.recipes": [
    {"name": "pdfLaTeX (TeX Live 2026)", "tools": ["latexmk-pdflatex"]}
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-pdflatex",
      "command": "/usr/local/bin/latexmk",
      "args": [
        "-g",
        "-pdf",
        "-pdflatex=/usr/local/bin/pdflatex %O %S",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-halt-on-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "files.associations": {
    "*.qmd": "quarto",
    "*.do": "stata",
    "*.ado": "stata"
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/.local/**": true
  },
  "python.envFile": "${workspaceFolder}/.env"
}
