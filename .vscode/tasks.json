{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Slides: vista previa sesión 1",
      "type": "process",
      "command": "bash",
      "args": ["slides/render.sh", "preview"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Slides: compilar sesión 1",
      "type": "process",
      "command": "bash",
      "args": ["slides/render.sh"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Overleaf: compilar recursos (TeX Live 2026)",
      "type": "process",
      "command": "bash",
      "args": ["scripts/render-overleaf.sh", "recursos"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Overleaf: compilar todos los documentos (TeX Live 2026)",
      "type": "process",
      "command": "bash",
      "args": ["scripts/render-overleaf.sh", "all"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Entorno: comprobar instalación",
      "type": "process",
      "command": "bash",
      "args": ["scripts/check-environment.sh"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Jupyter: abrir JupyterLab",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/jupyter",
      "args": ["lab", "--no-browser", "--ip=0.0.0.0", "--port=8888"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "HTML: vista previa",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "http.server", "8000", "--bind", "0.0.0.0", "--directory", "website"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Quarto: ejemplo Python a HTML",
      "type": "process",
      "command": "bash",
      "args": ["scripts/render-example.sh", "python", "html"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Quarto: ejemplo R a PDF",
      "type": "process",
      "command": "bash",
      "args": ["scripts/render-example.sh", "r", "pdf"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
